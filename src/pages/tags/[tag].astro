---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import { getPosts } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} wide>
  <div class="section-title" style="margin-top:0">
    <h1>#{tag}</h1>
    <span class="hand">{posts.length}개의 노트</span>
  </div>
  <NoteList posts={posts} />
  <p><a href="/tags">← 모든 화단</a></p>
</BaseLayout>
