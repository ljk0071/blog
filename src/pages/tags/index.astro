---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib';

const counts = new Map<string, number>();
for (const p of await getPosts()) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="태그">
  <p class="prompt">ls ~/blog/tags</p>
  <ul class="cloud">
    {
      tags.map(([t, n]) => (
        <li>
          <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>
          <span class="muted">({n})</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .cloud { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
</style>
