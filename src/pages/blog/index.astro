---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteBrowser from '../../components/NoteBrowser';
import { SITE_TITLE } from '../../consts';
import { getPosts, noteSummaries } from '../../lib';

const notes = noteSummaries(await getPosts());
---

<BaseLayout title="모든 노트" wide>
  <div class="section-title" style="margin-top:0">
    <h1>모든 노트</h1>
    <span class="hand">{notes.length}개가 자라는 중</span>
  </div>
  <NoteBrowser client:load notes={notes} search siteTitle={SITE_TITLE} />
</BaseLayout>
