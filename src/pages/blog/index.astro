---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostSearch from '../../components/PostSearch';
import { getPosts, formatDate, titleTransition } from '../../lib';

const posts = (await getPosts()).map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  date: formatDate(p.data.pubDate),
  iso: p.data.pubDate.toISOString(),
  tags: p.data.tags,
  stage: p.data.stage,
  transition: titleTransition(p.id),
}));
---

<BaseLayout title="모든 노트" wide>
  <div class="section-title" style="margin-top:0">
    <h1>모든 노트</h1>
    <span class="hand">{posts.length}개가 자라는 중</span>
  </div>
  <PostSearch client:load posts={posts} />
</BaseLayout>
