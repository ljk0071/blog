---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostSearch from '../../components/PostSearch';
import { getPosts, formatDate, titleTransition } from '../../lib';

const posts = (await getPosts()).map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  date: formatDate(p.data.pubDate),
  tags: p.data.tags,
  transition: titleTransition(p.id),
}));
---

<BaseLayout title="글 목록">
  <p class="prompt">ls -lt ~/blog/posts</p>
  <PostSearch client:load posts={posts} />
</BaseLayout>
