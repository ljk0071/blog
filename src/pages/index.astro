---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getPosts, formatDate } from '../lib';

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE}>
  <section class="hero">
    <h1>React를 깊게 파는 기술 블로그</h1>
    <p class="muted">{SITE_DESCRIPTION}</p>
  </section>

  <h2>최근 글</h2>
  <ul class="list">
    {
      posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
          <span class="muted">{formatDate(p.data.pubDate)}</span>
        </li>
      ))
    }
  </ul>
  <p><a href="/blog">전체 글 보기 →</a></p>
</BaseLayout>

<style>
  .hero { padding: 2rem 0 1rem; }
  .hero h1 { font-size: clamp(1.75rem, 5vw, 2.5rem); margin: 0 0 0.5rem; }
  .list { list-style: none; padding: 0; }
  .list li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
</style>
