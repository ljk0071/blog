---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Typewriter from '../components/Typewriter';
import { SITE_TITLE } from '../consts';
import { getPosts } from '../lib';

const posts = (await getPosts()).slice(0, 5);
const lines = [
  { cmd: 'whoami', out: 'ssobbs13 — React를 좋아하는 프론트엔드 개발자' },
  { cmd: 'cat interests.txt', out: 'React · 렌더링 · 웹 성능 · 프론트엔드 아키텍처' },
  { cmd: 'echo $MOTTO', out: '"측정하고, 이해하고, 기록한다."' },
];
---

<BaseLayout title={SITE_TITLE}>
  <section class="hero">
    <Typewriter client:load lines={lines} />
  </section>

  <section>
    <p class="prompt">ls -lt ~/blog/posts | head -5</p>
    <PostList posts={posts} />
    <p><a href="/blog">./posts --all</a></p>
  </section>
</BaseLayout>

<style>
  .hero { padding: 1rem 0 1.5rem; }
</style>
