---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <p class="prompt">cd <span id="path">this-page</span></p>
  <p><span class="err">bash: cd: No such file or directory</span> <span class="muted">(exit 404)</span></p>
  <p><a href="/">cd ~</a></p>
</BaseLayout>

<style>
  .err { color: #ff6b6b; }
</style>

<script is:inline>
  document.getElementById('path').textContent = location.pathname;
</script>
