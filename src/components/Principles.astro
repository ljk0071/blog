---
import { PROFILE } from '../consts';
---

<ul class="principles">
  {
    PROFILE.principles.map((p) => (
      <li class="card">
        <span class="emoji" aria-hidden="true">{p.emoji}</span>
        <div>
          <b>{p.title}</b>
          <p>{p.body}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .principles { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .principles li { display: flex; gap: 0.9rem; align-items: flex-start; padding: 0.85rem 1.1rem; }
  .emoji { font-size: 1.5rem; line-height: 1.3; }
  b { font-family: var(--serif); font-size: 1.02rem; }
  p { margin: 0.1rem 0 0; font-size: 0.9rem; line-height: 1.65; color: var(--muted); }
</style>
