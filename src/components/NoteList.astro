---
import { STAGES } from '../consts';
import { formatDate, noteTransition, type Post } from '../lib';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="notes" data-no-preview>
  {
    posts.map((p) => {
      const vt = noteTransition(p.id);
      return (
      <li>
        <article class="note">
          <span class="note-bg" aria-hidden="true" style={`view-transition-name: ${vt.card}; view-transition-class: note-card`} />
          <span class="stage" title={STAGES[p.data.stage].hint} style={`view-transition-name: ${vt.stage}; view-transition-class: note-part`}>
            {STAGES[p.data.stage].emoji} {STAGES[p.data.stage].label}
          </span>
          <a
            class="title"
            href={`/blog/${p.id}`}
            data-astro-prefetch="viewport"
            style={`view-transition-name: ${vt.title}; view-transition-class: note-part`}
          >
            {p.data.title}
          </a>
          <p class="desc">{p.data.description}</p>
          <div class="meta">
            <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
            {p.data.tags.map((t) => <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}
          </div>
        </article>
      </li>
      );
    })
  }
</ul>
