---
import { PORTFOLIO } from '../consts';
const host = new URL(PORTFOLIO.url).host;
---

<a class="portfolio card" href={PORTFOLIO.url} target="_blank" rel="noopener">
  <div class="browser" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="addr">{host}</span>
  </div>
  <div class="body">
    <p class="hand">정원 밖의 일기장 →</p>
    <h3>{PORTFOLIO.title}</h3>
    <p class="desc">{PORTFOLIO.description}</p>
    <ul class="chips">{PORTFOLIO.highlights.map((h) => <li>{h}</li>)}</ul>
    <span class="cta">{host} 방문하기 ↗</span>
  </div>
</a>

<style>
  .portfolio { display: block; overflow: hidden; color: var(--fg); background: var(--card); transition: transform 0.2s; }
  .portfolio:hover { transform: translateY(-3px) rotate(0.3deg); background: var(--card); color: var(--fg); }
  .browser { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 1rem; border-bottom: 1px solid var(--border); background: var(--accent-soft); }
  .dots { display: inline-flex; gap: 5px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--border); }
  .addr { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); background: var(--card); border-radius: 999px; padding: 0 0.75rem; }
  .body { padding: 1rem 1.5rem 1.4rem; }
  .hand { margin: 0; }
  h3 { margin: 0.1rem 0 0.25rem; font-size: 1.4rem; }
  .desc { margin: 0 0 0.75rem; color: var(--muted); }
  .chips { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips li { font-size: 0.8rem; padding: 0.1rem 0.7rem; border: 1px solid var(--border); border-radius: 999px; }
  .cta { font-weight: 600; color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .portfolio:hover { transform: none; } }
</style>
