---
import ThemeToggle from './ThemeToggle';
import { SITE_TITLE, PORTFOLIO } from '../consts';

const links = [
  { href: '/blog', label: '노트' },
  { href: '/tags', label: '태그' },
  { href: '/about', label: '소개' },
];
const path = Astro.url.pathname;
---

<header>
  <nav>
    <a class="brand" href="/"><span aria-hidden="true">🌿</span> {SITE_TITLE}</a>
    <div class="links">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={PORTFOLIO.url} target="_blank" rel="noopener">포트폴리오 ↗</a>
      <ThemeToggle client:load />
    </div>
  </nav>
</header>

<style>
  /* 페이지 전환 시 헤더는 애니메이션 없이 고정 */
  header { view-transition-name: site-header; }
  nav {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
  }
  a { background: none; }
  .brand { font-family: var(--serif); font-weight: 700; font-size: 1.1rem; color: var(--fg); }
  .links { display: flex; align-items: center; gap: 0.25rem 1.1rem; flex-wrap: wrap; font-size: 0.95rem; }
  .links a { color: var(--muted); }
  .links a:hover, .links a[aria-current='page'] { color: var(--fg); background: linear-gradient(transparent 60%, var(--highlight) 60%); }
</style>
