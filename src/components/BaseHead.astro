---
import '@fontsource/pretendard/400.css';
import '@fontsource/pretendard/600.css';
import '@fontsource/gowun-batang/400.css';
import '@fontsource/gowun-batang/700.css';
import '@fontsource/nanum-pen-script/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, GOOGLE_SITE_VERIFICATION } from '../consts';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
<script is:inline>
  // FOUC 방지: 페인트 전에 테마 적용.
  // ClientRouter는 head의 인라인 스크립트를 다시 실행하지 않으므로, 새 문서로 교체되기 직전(before-swap)에도 적용한다.
  (() => {
    const apply = (doc) => {
      let saved = null;
      try {
        saved = localStorage.getItem('theme');
      } catch {}
      const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      doc.documentElement.dataset.theme = dark ? 'dark' : 'light';
    };
    apply(document);
    document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
  })();
</script>
<script is:inline>
  // 노트 오버레이(React)가 처리할 뒤로/앞으로 가기를 ClientRouter보다 먼저 가로채는 훅.
  // ClientRouter의 popstate 리스너(모듈 스크립트)보다 먼저 등록돼야 하므로 head 인라인 스크립트로 둔다.
  addEventListener('popstate', (e) => {
    if (window.__notePopState && window.__notePopState(e)) e.stopImmediatePropagation();
  });
</script>
<!-- 링크 클릭 시 전체 새로고침 대신 새 페이지 HTML만 받아 View Transition으로 교체 -->
<ClientRouter />
