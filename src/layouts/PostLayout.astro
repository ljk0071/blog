---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, readingTime } from '../lib';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="muted">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && ` · 수정 ${formatDate(updatedDate)}`}
        {` · ${readingTime(post.body)}분 읽기`}
      </p>
      <div class="tags">
        {tags.map((t) => <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <p><a href="/blog">← 글 목록으로</a></p>
</BaseLayout>

<style>
  .post-header { margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
  .post-header h1 { margin-bottom: 0.25rem; }
  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .prose :global(h2) { margin-top: 2.5rem; }
</style>
