---
import BaseLayout from './BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import LinkPreview from '../components/LinkPreview';
import { STAGES } from '../consts';
import { backlinks, formatDate, getPosts, noteTransition, previewIndex, readingTime, type Post } from '../lib';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, stage } = post.data;
const posts = await getPosts();
const vt = noteTransition(post.id);
const linkedFrom = backlinks(post, posts);
const related = posts
  .filter((p) => p.id !== post.id && !linkedFrom.includes(p) && p.data.tags.some((t) => tags.includes(t)))
  .slice(0, 2);
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header note-header">
      <span class="note-bg" aria-hidden="true" style={`view-transition-name: ${vt.card}; view-transition-class: note-card`}></span>
      <p class="stage-line">
        <span class="stage-pill" title={STAGES[stage].hint} style={`view-transition-name: ${vt.stage}; view-transition-class: note-part`}>{STAGES[stage].emoji} {STAGES[stage].label}</span>
        <span class="hand">{STAGES[stage].hint}</span>
      </p>
      <h1 style={`view-transition-name: ${vt.title}; view-transition-class: note-part`}>{title}</h1>
      <p class="meta">
        <span>심은 날 <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
        {updatedDate && <span>마지막으로 돌본 날 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
        <span>{readingTime(post.body)}분</span>
      </p>
      <p class="tags">{tags.map((t) => <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>

  {
    linkedFrom.length > 0 && (
      <section>
        <div class="section-title">
          <h2>이 노트를 언급한 곳</h2>
          <span class="hand">backlinks</span>
        </div>
        <NoteList posts={linkedFrom} />
      </section>
    )
  }
  {
    related.length > 0 && (
      <section>
        <div class="section-title">
          <h2>같은 화단의 노트</h2>
          <span class="hand">같은 태그</span>
        </div>
        <NoteList posts={related} />
      </section>
    )
  }

  <LinkPreview client:idle items={previewIndex(posts)} />
</BaseLayout>

<style>
  /* 목록의 노트 카드가 그대로 커져서 이 헤더가 된다 */
  .post-header { margin-bottom: 2.5rem; padding: 1.5rem 1.75rem 1.4rem; }
  .post-header h1 { margin: 0.5rem 0 0.75rem; }
  .stage-line { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin: 0; }
  .stage-pill { font-size: 0.85rem; padding: 0.15rem 0.75rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .stage-line .hand { font-size: 1.25rem; }
  .meta { display: flex; gap: 0.25rem 1.25rem; flex-wrap: wrap; color: var(--muted); font-size: 0.9rem; margin: 0; }
  .tags { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 0.25rem 0 0; }
  .prose :global(h2) { margin-top: 2.75rem; }
  .prose :global(a[href^='/blog/'])::after { content: ' 🌱'; font-size: 0.75em; }
</style>
